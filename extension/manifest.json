{
  "manifest_version": 3,
  "name": "AudioTranslate Live",
  "description": "Capture the active Chrome or Edge tab and stream audio to the local subtitle overlay.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "offscreen", "storage", "tabCapture"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AudioTranslate Live",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*"
  }
}
