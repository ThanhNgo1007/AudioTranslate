# Advanced headless/automation configuration only. Desktop users should run
# `npm start` and configure provider, API key and languages in Control Center.
# Desktop stores the Gemini key with Electron safeStorage instead of this file.
# On Linux `basic_text`, the desktop key is session-only rather than plaintext.
AUDIOTRANSLATE_PROVIDER=demo
AUDIOTRANSLATE_PORT=43765
AUDIOTRANSLATE_SOURCE=auto
# Provider-specific hints: Gemini accepts 0-8 optional language codes/locales.
# Azure at-start LID requires 2-4 full locales with distinct base languages.
AUDIOTRANSLATE_SOURCE_CANDIDATES=
AUDIOTRANSLATE_TARGET=vi
AUDIOTRANSLATE_SHOW_SOURCE=true
AUDIOTRANSLATE_CLICK_THROUGH=true

# Headless only: set after explicit permission to send selected audio to cloud.
# Gemini: gemini:audio:v1   Azure tab capture: azure:tab-audio:v1
AUDIOTRANSLATE_CLOUD_CONSENT=
# App-side duration guardrail; it is not a provider billing cap.
AUDIOTRANSLATE_MAX_CLOUD_MINUTES=0

# Desktop creates its pairing secret automatically. Headless/automation must inject
# a separate high-entropy value here. It authenticates peers with nonce-based HMAC
# and is not sent as a bearer value. Never pass it as a CLI argument.
AUDIOTRANSLATE_TOKEN=

# The manifest key keeps this unpacked Chrome/Edge extension ID stable.
# Keep it pinned unless you intentionally build/sign the extension with a different key.
AUDIOTRANSLATE_EXTENSION_IDS=docfjemeacdakckkamiiopljhmgjgfgl

# Required for Gemini headless/automation; never read from desktop safeStorage.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview
# Privacy-first default: start a fresh Live session at connection rotation instead
# of asking Google to retain resumable session state. Set true only after reviewing
# Gemini Live session-management/data-retention documentation.
GEMINI_SESSION_RESUMPTION=false

# Optional advanced/headless Azure adapter; not shown in the desktop provider picker.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Development tests only. Leave false for normal use.
AUDIOTRANSLATE_ALLOW_DEV_CLIENTS=false
